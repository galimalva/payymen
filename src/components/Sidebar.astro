<aside class="sidebar glass">
  <div class="logo">
    AF
  </div>

  <nav>
    <a href="#home" aria-label="خانه">
      ⌂
    </a>

    <a href="#works" aria-label="آثار">
      ✎
    </a>

    <a href="#about" aria-label="درباره من">
      ◇
    </a>

    <a href="#contact" aria-label="ارتباط">
      ✉️
    </a>
  </nav>

  <!-- =========================
       کنترل شیشه‌ای تغییر تم
  ========================== -->
  <div class="theme-control" id="theme-control">
    <div class="theme-rail"></div>

    <button
      class="theme-toggle"
      id="theme-toggle"
      type="button"
      aria-label="تغییر حالت روشن و تاریک"
      title="تغییر تم"
    >
      <span class="theme-orb">
        <span class="theme-symbol">☀️</span>
      </span>
    </button>
  </div>
</aside>

<style>
/* =========================
   سایدبار
========================= */

.sidebar {
  position: sticky;
  top: 30px;

  height: calc(100vh - 60px);

  padding: 20px 10px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;

  border-radius: 30px;
}


/* =========================
   لوگو
========================= */

.logo {
  width: 48px;
  height: 48px;

  display: grid;
  place-items: center;

  border-radius: 16px;

  font-weight: 800;

  background:
    linear-gradient(
      135deg,
      #F0C76A,
      #2E7BC6
    );

  color: #111;
}


/* =========================
   منو
========================= */

nav {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

nav a {
  width: 50px;
  height: 50px;

  border-radius: 16px;

  display: grid;
  place-items: center;

  font-size: 20px;

  color: #aeb5b2;

  transition:
    color 0.3s ease,
    background 0.3s ease,
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

nav a:hover,
nav a.active {
  color: white;

  background:
    rgba(255, 255, 255, 0.08);

  box-shadow:
    inset 3px 0 0 #F0C76A;
}

nav a:hover {
  transform: translateY(-2px);
}


/* =========================
   کنترل تم
========================= */

.theme-control {
  position: relative;

  width: 52px;
  height: 128px;

  flex: 0 0 auto;

  touch-action: none;
}


/* =========================
   مسیر شیشه‌ای
========================= */

.theme-rail {
  position: absolute;

  left: 50%;
  top: 0;

  transform: translateX(-50%);

  width: 50px;
  height: 128px;

  border-radius: 28px;

  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.13),
      rgba(255, 255, 255, 0.045)
    );

  border:
    1px solid rgba(255, 255, 255, 0.16);

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.35),
    inset 0 -1px 0 rgba(0,0,0,0.12),
    0 12px 30px rgba(0,0,0,0.16);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}


/* خط درخشان داخل مسیر */

.theme-rail::after {
  content: "";

  position: absolute;

  left: 50%;
  top: 21px;

  transform: translateX(-50%);

  width: 3px;
  height: 86px;

  border-radius: 99px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,0.55),
      rgba(255,255,255,0.07)
    );

  opacity: 0.45;
}


/* =========================
   خود دکمه
========================= */

.theme-toggle {
  position: absolute;

  left: 50%;
  top: 5px;

  transform:
    translateX(-50%)
    translateY(0);

  width: 42px;
  height: 42px;

  padding: 0;

  border: 0;

  border-radius: 50%;

  background: transparent;

  cursor: grab;

  z-index: 2;

  transition:
    transform 0.55s cubic-bezier(.22,.85,.25,1),
    filter 0.35s ease;
}

.theme-toggle:active {
  cursor: grabbing;
}


/* =========================
   گوی Liquid Glass
========================= */

.theme-orb {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background:
    radial-gradient(
      circle at 30% 22%,
      rgba(255,255,255,0.78),
      rgba(255,255,255,0.18) 35%,
      rgba(255,255,255,0.07) 70%
    );

  border:
    1px solid rgba(255,255,255,0.42);
    box-shadow:
    inset 0 2px 3px rgba(255,255,255,0.75),
    inset 0 -4px 7px rgba(0,0,0,0.08),
    0 7px 18px rgba(0,0,0,0.18),
    0 0 16px rgba(255,255,255,0.18);

  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);

  transition:
    box-shadow 0.4s ease,
    background 0.4s ease,
    transform 0.4s ease;
}


/* انعکاس بالای گوی */

.theme-orb::before {
  content: "";

  position: absolute;

  width: 18px;
  height: 8px;

  top: 5px;
  left: 8px;

  border-radius: 50%;

  background:
    rgba(255,255,255,0.55);

  filter: blur(3px);

  transform: rotate(-20deg);
}


/* =========================
   آیکن
========================= */

.theme-symbol {
  position: relative;

  z-index: 2;

  font-size: 19px;

  color: #1f2937;

  line-height: 1;

  user-select: none;

  pointer-events: none;

  transition:
    transform 0.5s ease,
    color 0.4s ease,
    opacity 0.3s ease;
}


/* =========================
   وقتی تم روشن است
========================= */

:global(html[data-theme="light"]) .theme-toggle {
  transform:
    translateX(-50%)
    translateY(76px);
}

:global(html[data-theme="light"]) .theme-symbol {
  color: #111827;

  transform: rotate(180deg);
}


/* =========================
   وقتی تم تاریک است
========================= */

:global(html[data-theme="dark"]) .theme-toggle {
  transform:
    translateX(-50%)
    translateY(0);
}

:global(html[data-theme="dark"]) .theme-symbol {
  color: white;
}


/* =========================
   جلوه تم روشن
========================= */

:global(html[data-theme="light"]) .theme-orb {
  background:
    radial-gradient(
      circle at 30% 22%,
      rgba(255,255,255,0.95),
      rgba(244,221,157,0.28) 34%,
      rgba(111,168,230,0.10) 72%
    );

  box-shadow:
    inset 0 2px 3px rgba(255,255,255,0.9),
    inset 0 -4px 8px rgba(0,0,0,0.06),
    0 8px 24px rgba(240,199,106,0.25),
    0 0 22px rgba(255,255,255,0.32);
}


/* =========================
   موبایل
========================= */

@media (max-width: 800px) {

  .sidebar {
    position: fixed;

    z-index: 1000;

    left: 50%;
    bottom: 14px;
    top: auto;

    transform: translateX(-50%);

    width: calc(100% - 24px);
    max-width: 520px;

    height: 72px;

    padding: 8px;

    flex-direction: row;

    align-items: center;

    justify-content: center;

    border-radius: 24px;
  }


  .logo {
    display: none;
  }


  .sidebar nav {
    flex: 1;

    display: grid;

    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap: 3px;

    min-width: 0;
  }


  .sidebar nav a {
    width: 100%;
    height: 52px;

    min-width: 0;

    display: grid;
    place-items: center;

    border-radius: 15px;

    font-size: 20px;

    box-shadow: none;
  }


  .sidebar nav a.active {
    background:
      rgba(255, 255, 255, 0.09);

    box-shadow:
      inset 0 -3px 0 #F0C76A;
  }


  /* در موبایل مسیر افقی می‌شود */

  .theme-control {
    width: 112px;
    height: 52px;

    margin-inline-start: 6px;
  }


  .theme-rail {
    width: 112px;
    height: 50px;

    top: 1px;

    border-radius: 26px;
  }


  .theme-rail::after {
    top: 50%;
    left: 20px;

    transform: translateY(-50%);

    width: 72px;
    height: 3px;
  }


  .theme-toggle {
    top: 5px;
    left: 5px;

    transform:
      translateX(0)
      translateY(0);

    width: 42px;
    height: 42px;
  }


  :global(html[data-theme="dark"]) .theme-toggle {
    transform:
      translateX(0)
      translateY(0);
  }


  :global(html[data-theme="light"]) .theme-toggle {
    transform:
      translateX(60px)
      translateY(0);
  }
}


/* =========================
   گوشی خیلی کوچک
========================= */

@media (max-width: 380px) {

  .sidebar {
    width: calc(100% - 16px);

    padding: 6px;

    height: 66px;
  }


  .sidebar nav {
    gap: 1px;
  }


  .sidebar nav a {
    height: 48px;

    font-size: 18px;
  }


  .theme-control {
    width: 96px;
    height: 48px;
  }


  .theme-rail {
    width: 96px;
    height: 46px;
  }


  .theme-toggle {
    width: 38px;
    height: 38px;
    top: 5px;
    left: 5px;
  }


  .theme-orb {
    width: 38px;
    height: 38px;
  }


  :global(html[data-theme="light"]) .theme-toggle {
    transform:
      translateX(48px)
      translateY(0);
  }
}
@media (max-width: 600px) {

  .sidebar {
    position: fixed;
    z-index: 1000;

    left: 50%;
    right: auto;
    bottom: 12px;
    top: auto;

    transform: translateX(-50%);

    width: calc(100% - 24px);
    height: 68px;

    padding: 7px 8px;

    display: flex;
    flex-direction: row;
    align-items: center;

    border-radius: 22px;
  }

  .logo {
    display: none;
  }

  .sidebar nav {
    flex: 1;
    min-width: 0;

    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 3px;
  }

  .sidebar nav a {
    width: 100%;
    height: 50px;

    display: grid;
    place-items: center;

    padding: 0;
    margin: 0;

    font-size: 19px;

    border-radius: 14px;
  }

  .theme-toggle {
    flex: 0 0 48px;

    width: 48px;
    height: 48px;

    padding: 0;
    margin-inline-start: 4px;

    border-radius: 14px;
  }

  .theme-orb {
    width: 20px;
    height: 20px;
  }
}
</style>

<script>
  const themeToggle =
    document.getElementById("theme-toggle");

  const themeControl =
    document.getElementById("theme-control");

  const themeSymbol =
    document.querySelector(".theme-symbol");


  /* =========================
     خواندن تم ذخیره شده
  ========================== */

  const savedTheme =
    localStorage.getItem("theme");


  if (savedTheme === "light") {

    document.documentElement.setAttribute(
      "data-theme",
      "light"
    );

    if (themeSymbol) {
      themeSymbol.textContent = "☀️";
    }

  } else {

    document.documentElement.setAttribute(
      "data-theme",
      "dark"
    );

    if (themeSymbol) {
      themeSymbol.textContent = "☾";
    }
  }


  /* =========================
     تابع تغییر تم
  ========================== */

  function setTheme(theme) {

    document.documentElement.setAttribute(
      "data-theme",
      theme
    );

    localStorage.setItem(
      "theme",
      theme
    );


    if (themeSymbol) {

      themeSymbol.textContent =
        theme === "light"
          ? "☀️"
          : "☾";
    }
  }


  /* =========================
     کلیک ساده
  ========================== */

  themeToggle?.addEventListener(
    "click",
    () => {

      const currentTheme =
        document.documentElement.getAttribute(
          "data-theme"
        );


      const newTheme =
        currentTheme === "light"
          ? "dark"
          : "light";


      setTheme(newTheme);
    }
  );


  /* =========================
     کشیدن با انگشت یا موس
  ========================== */

  let dragging = false;


  themeToggle?.addEventListener(
    "pointerdown",
    (event) => {

      dragging = true;

      themeToggle.setPointerCapture(
        event.pointerId
      );
    }
  );


  themeToggle?.addEventListener(
    "pointerup",
    (event) => {

      if (!dragging || !themeControl) {
        return;
      }


      dragging = false;


      const rect =
        themeControl.getBoundingClientRect();


      const isMobile =
        window.innerWidth <= 800;


      if (isMobile) {

        const position =
          event.clientX - rect.left;


        if (position > rect.width / 2) {

          setTheme("light");

        } else {

          setTheme("dark");
        }

      } else {

        const position =
          event.clientY - rect.top;


        if (position > rect.height / 2) {

          setTheme("light");

        } else {

          setTheme("dark");
        }
      }
    }
  );
</script>