</style>


<script>

  const themeToggle =
    document.getElementById("theme-toggle");

  const savedTheme =
    localStorage.getItem("theme");


  if (savedTheme === "light") {

    document.documentElement.setAttribute(
      "data-theme",
      "light"
    );

  } else {

    document.documentElement.setAttribute(
      "data-theme",
      "dark"
    );

  }


  themeToggle?.addEventListener("click", () => {

    const currentTheme =
      document.documentElement.getAttribute(
        "data-theme"
      );

    const newTheme =
      currentTheme === "light"
        ? "dark"
        : "light";


    document.documentElement.setAttribute(
      "data-theme",
      newTheme
    );

    localStorage.setItem(
      "theme",
      newTheme
    );

  });

</script>