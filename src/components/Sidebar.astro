<aside class="sidebar glass">

  <div class="logo">AF</div>

  <nav>
    <a href="#home" aria-label="خانه">⌂</a>
    <a href="#works" aria-label="آثار">✎</a>
    <a href="#about" aria-label="درباره من">◇</a>
    <a href="#contact" aria-label="ارتباط">✉️</a>
  </nav>

  <button
    class="theme-toggle"
    id="theme-toggle"
    type="button"
    aria-label="تغییر تم"
  >
    <span class="theme-orb"></span>
  </button>

</aside>

<style>

.sidebar {
  position: sticky;
  top: 30px;

  height: calc(100vh - 60px);

  padding: 20px 10px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;

  border-radius: 30px;
}


/* لوگو */

.logo {
  width: 48px;
  height: 48px;

  display: grid;
  place-items: center;

  border-radius: 16px;

  font-weight: 800;
  color: #111;

  background: linear-gradient(
    135deg,
    #F0C76A,
    #2E7BC6
  );
}


/* منو دسکتاپ */

nav {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

nav a {
  width: 50px;
  height: 50px;

  display: grid;
  place-items: center;

  padding: 0;

  border-radius: 16px;

  color: #aeb5b2;
  font-size: 20px;

  background: transparent;

  transition:
    background .3s ease,
    color .3s ease,
    transform .3s ease;
}

nav a:hover {
  color: #fff;
  background: rgba(255,255,255,.08);
  transform: translateY(-2px);
}


/* دکمه تم */

.theme-toggle {
  appearance: none;
  -webkit-appearance: none;

  box-sizing: border-box;

  width: 50px;
  height: 50px;

  min-width: 50px;
  max-width: 50px;

  min-height: 50px;
  max-height: 50px;

  padding: 0;
  margin: 0;

  display: grid;
  place-items: center;

  border-radius: 16px;

  border: 1px solid rgba(255,255,255,.10);

  background: rgba(255,255,255,.045);

  cursor: pointer;
}


/* گوی تم */

.theme-orb {
  width: 22px;
  height: 22px;

  display: block;

  border-radius: 50%;

  background: linear-gradient(
    135deg,
    #F0C76A 0%,
    #6B8B5A 35%,
    #2F6F6D 55%,
    #2E7BC6 100%
  );

  box-shadow:
    0 0 0 1px rgba(255,255,255,.22),
    0 4px 14px rgba(46,123,198,.28),
    inset 3px 3px 5px rgba(255,255,255,.30);

  transition: transform .4s ease;
}

.theme-toggle:hover .theme-orb {
  transform: rotate(180deg);
}


/* حالت روشن */

:global(html[data-theme="light"]) .theme-orb {
  transform: rotate(180deg);

  background: linear-gradient(
    135deg,
    #F0C76A,
    #E7B24D,
    #6B8B5A,
    #2E7BC6
  );
}


/* =========================
   موبایل
========================= */

@media (max-width: 800px) {

  .sidebar {
    position: fixed;

    z-index: 1000;

    left: 50%;
    right: auto;

    bottom: 12px;
    top: auto;

    transform: translateX(-50%);

    width: calc(100% - 24px);
    height: 68px;

    padding: 7px 8px;

    display: grid;

    /* دقیقاً پنج خانه مساوی */
    grid-template-columns: repeat(5, minmax(0, 1fr));

    align-items: center;

    border-radius: 22px;

    box-sizing: border-box;
  }


  /* AF در موبایل مخفی */

  .logo {
    display: none;
  }


  /*
    nav را از چیدمان حذف می‌کنیم
    تا چهار لینک مستقیماً عضو Grid شوند
  */

  .sidebar nav {
    display: contents;
  }


  /* چهار دکمه اصلی */

  .sidebar nav a {
    width: 48px;
    height: 48px;

    min-width: 0;

    padding: 0;
    margin: 0 auto;

    display: grid;
    place-items: center;

    border-radius: 14px;

    font-size: 20px;

    box-shadow: none;
  }


  .sidebar nav a:hover {
    transform: none;
  }


  /* دکمه تم؛ دقیقاً هم‌اندازه بقیه */

  .sidebar .theme-toggle {
    appearance: none;
    -webkit-appearance: none;

    width: 48px;
    height: 48px;

    min-width: 48px;
    max-width: 48px;

    min-height: 48px;
    max-height: 48px;

    padding: 0;
    margin: 0 auto;

    display: grid;
    place-items: center;

    border-radius: 14px;

    box-sizing: border-box;

    flex: none;
  }


  .sidebar .theme-orb {
    width: 21px;
    height: 21px;

    min-width: 21px;
    min-height: 21px;

    margin: 0;
    padding: 0;
  }

}

</style>


<script>
  const themeToggle =
    document.getElementById("theme-toggle");

  const themes = [
    "dark",
    "light",
    "purple"
  ];

  const savedTheme =
    localStorage.getItem("theme") || "dark";

  document.documentElement.setAttribute(
    "data-theme",
    savedTheme
  );

  themeToggle?.addEventListener("click", () => {

    const currentTheme =
      document.documentElement.getAttribute("data-theme")
      || "dark";

    const currentIndex =
      themes.indexOf(currentTheme);

    const nextIndex =
      (currentIndex + 1) % themes.length;

    const nextTheme =
      themes[nextIndex];

    document.documentElement.setAttribute(
      "data-theme",
      nextTheme
    );

    localStorage.setItem(
      "theme",
      nextTheme
    );

  });
</script>