<aside class="sidebar glass">
  <div class="logo">
    AF
  </div>

  <nav>
    <a href="#home" class="active">
      ⌂
    </a>

    <a href="#works">
      ✎
    </a>

    <a href="#about">
      ◇
    </a>

    <a href="#contact">
      ✉️
    </a>
  </nav>

  <button
    class="theme-toggle"
    id="theme-toggle"
    type="button"
    aria-label="تغییر پالت رنگ"
    title="تغییر پالت رنگ"
  >
    <span class="theme-orb"></span>
  </button>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 30px;
    height: calc(100vh - 60px);

    padding: 20px 10px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;

    border-radius: 30px;
  }

  .logo {
    width: 48px;
    height: 48px;

    display: grid;
    place-items: center;

    border-radius: 16px;

    font-weight: 800;

    background: linear-gradient(
      135deg,
      #F0C76A,
      #2E7BC6
    );

    color: #111;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  nav a {
    width: 50px;
    height: 50px;

    border-radius: 16px;

    display: grid;
    place-items: center;

    font-size: 20px;

    color: #aeb5b2;

    transition:
      color 0.3s ease,
      background 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  nav a:hover,
  nav a.active {
    color: white;

    background:
      rgba(255, 255, 255, 0.08);

    box-shadow:
      inset 3px 0 0 #F0C76A;
  }

  nav a:hover {
    transform: translateY(-2px);
  }

  .theme-toggle {
    position: relative;

    width: 50px;
    height: 50px;

    padding: 0;

    display: grid;
    place-items: center;

    border:
      1px solid rgba(255, 255, 255, 0.10);

    border-radius: 16px;

    background:
      rgba(255, 255, 255, 0.045);

    cursor: pointer;

    overflow: hidden;

    transition:
      transform 0.3s ease,
      background 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .theme-toggle:hover {
    transform: translateY(-2px);

    background:
      rgba(255, 255, 255, 0.09);

    border-color:
      rgba(255, 255, 255, 0.16);

    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.18);
  }

  .theme-orb {
    position: relative;

    width: 23px;
    height: 23px;

    display: block;

    border-radius: 50%;

    background:
      linear-gradient(
        135deg,
        #2F6BFF 0%,
        #4C8DDB 28%,
        #6FA8E6 47%,
        #4CC7B7 68%,
        #2BB5A6 100%
      );

    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.18),
      0 4px 15px rgba(47, 107, 255, 0.30),
      inset 3px 3px 5px rgba(255, 255, 255, 0.32),
      inset -3px -3px 5px rgba(0, 0, 0, 0.10);

    transition:
      transform 0.55s cubic-bezier(.2,.8,.2,1),
      box-shadow 0.4s ease;
  }

  .theme-orb::after {
    content: "";

    position: absolute;

    width: 7px;
    height: 7px;

    top: 4px;
    left: 5px;

    border-radius: 50%;

    background:
      rgba(255, 255, 255, 0.58);

    filter: blur(0.4px);
  }

  .theme-toggle:hover .theme-orb {
    transform:
      rotate(180deg)
      scale(1.08);

    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.22),
      0 5px 20px rgba(76, 199, 183, 0.42),
      inset 3px 3px 6px rgba(255, 255, 255, 0.38),
      inset -3px -3px 6px rgba(0, 0, 0, 0.10);
  }

  :global(html[data-theme="light"]) .theme-orb {
    transform: rotate(180deg);

    background:
      linear-gradient(
        135deg,
        #2BB5A6 0%,
        #4CC7B7 28%,
        #7FD9CC 48%,
        #6FA8E6 70%,
        #2F6BFF 100%
      );

    box-shadow:
      0 0 0 1px rgba(214, 243, 239, 0.25),
      0 5px 18px rgba(43, 181, 166, 0.38),
      inset 3px 3px 6px rgba(255, 255, 255, 0.38),
      inset -3px -3px 6px rgba(0, 0, 0, 0.08);
  }

  :global(html[data-theme="light"]) .theme-toggle {
    background:
      rgba(111, 168, 230, 0.10);

    border-color:
      rgba(127, 217, 204, 0.22);
  }

  @media (max-width: 800px) {
    .sidebar {
      position: fixed;

      z-index: 100;

      bottom: 18px;
      top: auto;
      left: 50%;
      transform: translateX(-50%);

      width: calc(100% - 36px);
      height: 72px;

      flex-direction: row;

      padding: 10px 18px;
    }

    .sidebar nav {
      flex-direction: row;
    }

    .theme-toggle {
      width: 46px;
      height: 46px;
    }

    .theme-orb {
      width: 21px;
      height: 21px;
    }
  }
</style>

<script>
  const themeToggle = document.getElementById("theme-toggle");

  const savedTheme = localStorage.getItem("theme");

  if (savedTheme === "light") {
    document.documentElement.setAttribute(
      "data-theme",
      "light"
    );
  } else {
    document.documentElement.setAttribute(
      "data-theme",
      "dark"
    );
  }

  themeToggle?.addEventListener("click", () => {
    const currentTheme =
      document.documentElement.getAttribute("data-theme");

    const newTheme =
      currentTheme === "light"
        ? "dark"
        : "light";

    document.documentElement.setAttribute(
      "data-theme",
      newTheme
    );

    localStorage.setItem(
      "theme",
      newTheme
    );
  });
</script>