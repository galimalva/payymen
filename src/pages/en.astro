import Layout from "../layouts/Layout.astro";

import Sidebar from "../components/Sidebar.astro";
import Hero from "../components/Hero.astro";
import Works from "../components/Works.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
---

<Layout title="Arefa Payman">

  <main class="page">

    <Sidebar />

    <div class="content">

      <section class="hero glass">

        <div class="hero-bg"></div>

        <div class="hero-content">

          <span class="eyebrow">
            Personal Website
          </span>

          <h1 class="name-title">
            <span>Arefa</span>
            <span class="gradient-text">Payman</span>
          </h1>

          <h2>
            Writer and Storyteller
          </h2>

          <p>
            This is a small part of my world;
            a place for stories, writings,
            experiences, and things worth preserving.
          </p>

          <div class="actions">

            <a href="#works" class="primary">
              View Works
            </a>

            <a href="#about" class="secondary">
              About Me
            </a>

          </div>

        </div>

        <div class="visual">

          <img
            src="/profile.jpg"
            alt="Profile photo"
            class="portrait-placeholder"
          />

        </div>

      </section>


      <section id="works" class="works glass">

        <div class="section-head">

          <div>
            <span>Works</span>

            <h2>
              Latest Writings
            </h2>
          </div>

        </div>

        <div class="works-grid">

          <article class="work-card">

            <div class="cover cover-1"></div>

            <span class="category">
              Short Story
            </span>

            <h3>
              Beyond the Window
            </h3>

            <p>
              A short story about silence,
              waiting, and people who arrive home too late.
            </p>

            <a href="#">
              Read Story →
            </a>

          </article>


          <article class="work-card">

            <div class="cover cover-2"></div>

            <span class="category">
              Note
            </span>

            <h3>
              When the City Goes Dark
            </h3>

            <p>
              A reflection on the city,
              darkness, and everyday life.
            </p>

            <a href="#">
              Read More →
            </a>

          </article>


          <article class="work-card">

            <div class="cover cover-3"></div>

            <span class="category">
              Story
            </span>

            <h3>
              The Last Station
            </h3>

            <p>
              A story about leaving,
              staying, and things that were never said.
            </p>

            <a href="#">
              Read →
            </a>

          </article>

        </div>

      </section>


      <section id="about" class="about glass">

        <div class="about-visual">

          <img
            src="/about.jpg"
            alt="About me"
            class="about-image"
          />

        </div>

        <div class="about-content">

          <span>
            About Me
          </span>

          <h2>
            Behind the Words
          </h2>

          <p>
            Writing is not simply about putting
            a few sentences together.

            Stories are where people,
            memories, fears, and hopes
            come alive again.
          </p>

          <div class="stats">

            <div>
              <strong>25+</strong>
              <small>Stories</small>
            </div>

            <div>
              <strong>10+</strong>
              <small>Projects</small>
            </div>

            <div>
              <strong>5+</strong>
              <small>Years</small>
            </div>

          </div>

        </div>

      </section>
