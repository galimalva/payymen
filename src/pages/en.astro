<style>

.page {
  width: min(1500px, 94%);
  margin: auto;

  display: grid;

  grid-template-columns: 90px 1fr;

  gap: 28px;

  padding: 35px 0;
}

.content {
  display: flex;
  flex-direction: column;

  gap: 28px;
}


/* Hero */

.hero {
  position: relative;

  min-height: 620px;

  padding: 70px;

  display: grid;

  grid-template-columns: 1.2fr 0.8fr;

  align-items: center;

  gap: 50px;

  overflow: hidden;

  direction: ltr;
}

.hero-content {
  position: relative;
  z-index: 2;
}

.name-title {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
}

.eyebrow {
  display: inline-block;
  margin-bottom: 22px;
  color: #F0C76A;
}

.hero h1 {
  font-size: clamp(55px, 8vw, 120px);
  line-height: 0.95;
  margin-bottom: 25px;
}

.hero h2 {
  font-size: 22px;
  margin-bottom: 28px;
}

.hero p {
  max-width: 600px;
  font-size: 18px;
  line-height: 2;
}

.actions {
  display: flex;
  gap: 15px;
  margin-top: 35px;
}

.actions a {
  padding: 14px 25px;
  border-radius: 15px;
}

.primary {
  background: linear-gradient(
    90deg,
    #F0C76A,
    #2E7BC6
  );

  color: #101010;
  font-weight: bold;
}

.secondary {
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.08);
}

.visual {
  display: flex;
  justify-content: center;
}

.portrait-placeholder {
  width: 340px;
  height: 430px;

  object-fit: cover;
  object-position: center;

  border-radius: 35px;
}


/* Works */

.works {
  padding: 45px;
  direction: ltr;
}

.section-head h2 {
  font-size: 35px;
  margin-top: 8px;
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.work-card {
  padding: 18px;
  border-radius: 24px;

  background: rgba(255,255,255,.035);
  border: 1px solid rgba(255,255,255,.06);
}

.cover {
  height: 230px;
  border-radius: 18px;
  margin-bottom: 22px;
}

.cover-1 {
  background: linear-gradient(
    135deg,
    #F0C76A,
    #7A5A2E,
    #2A2A2A
  );
}

.cover-2 {
  background: linear-gradient(
    135deg,
    #2F6F6D,
    #2E7BC6,
    #415A8A
  );
}

.cover-3 {
  background: linear-gradient(
    135deg,
    #6B8B5A,
    #B7964A,
    #2A2A2A
  );
}


/* About */

.about {
  padding: 45px;

  display: grid;

  grid-template-columns: 0.8fr 1.2fr;

  gap: 55px;

  align-items: center;

  direction: ltr;
}

.about-image {
  width: 280px;
  height: 350px;

  object-fit: cover;
  object-position: center;

  display: block;
  margin: 0 auto;

  border-radius: 24px;
}

.about-content h2 {
  font-size: 45px;
  margin: 12px 0 25px;
}

.stats {
  display: flex;
  gap: 40px;
  margin-top: 40px;
}

.stats div {
  display: flex;
  flex-direction: column;
  gap: 8px;
}


/* Contact */

.contact {
  text-align: center;
  padding: 80px 30px;

  direction: ltr;
}

.contact h2 {
  font-size: clamp(32px, 5vw, 60px);
  margin: 15px 0 20px;
}

.contact p {
  margin: auto;
  max-width: 600px;
}

.contact a {
  display: inline-block;

  margin-top: 30px;

  padding: 15px 30px;

  border-radius: 16px;

  background: linear-gradient(
    90deg,
    #F0C76A,
    #6B8B5A,
    #2E7BC6
  );

  color: #101010;
  font-weight: bold;
}


/* Mobile */

@media (max-width: 800px) {

  .page {
    display: block;
    width: 100%;
    padding: 14px 14px 110px;
  }

  .content {
    gap: 18px;
  }

}

@media (max-width: 600px) {

  .hero {
    min-height: auto;

    padding: 22px 18px 32px;

    grid-template-columns: 1fr;

    gap: 28px;

